{
  "manifest_version": 3,
  "name": "Pretty Bugz",
  "version": "1.0.0",
  "description": "A cleaner, more modern look and more usable layouts for bugzilla.mozilla.org.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pretty-bugz@nwipper",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://bugzilla.mozilla.org/*"
  ],
  "action": {
    "default_title": "Pretty Bugz",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bugzilla.mozilla.org/*"
      ],
      "css": [
        "content/theme.css",
        "content/layouts.css",
        "content/layouts/enter-bug.css",
        "content/layouts/buglist.css",
        "content/layouts/simple-search.css"
      ],
      "js": [
        "content/lib.js",
        "content/layouts/query.js",
        "content/layouts/enter-bug.js",
        "content/layouts/buglist.js",
        "content/layouts/simple-search.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
